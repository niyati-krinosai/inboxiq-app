# Backend — InboxIQ Intelligence Layer
# Copy to .env and fill in your values. Never commit .env.

DATABASE_URL=postgresql+asyncpg://inboxiq:inboxiq@localhost:5432/inboxiq
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Google OAuth (read-only Gmail scopes ONLY)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/callback

# JWT — generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-in-production

# OAuth token encryption at rest
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# OpenAI (optional in SIMPLE_MODE)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# Frontend redirect after OAuth
FRONTEND_URL=http://localhost:3000
# Production: https://inboxiq-iota.vercel.app
# CORS_EXTRA_ORIGINS=https://inboxiq-iota.vercel.app

# Processing
INITIAL_SYNC_MAX_MESSAGES=2000
SYNC_INTERVAL_SECONDS=3600
ENRICH_OFFICIAL_SOURCES=true
SIMPLE_MODE=true

# Model versioning
EXTRACTION_PROMPT_VERSION=v1
CHAT_PROMPT_VERSION=v1
CANONICALIZE_PROMPT_VERSION=v1

# API rate limiting (requests per minute per IP)
API_RATE_LIMIT_RPM=120

# Gmail Push (optional — requires Google Cloud Pub/Sub)
# GMAIL_PUBSUB_TOPIC=projects/my-project/topics/gmail-push
# GMAIL_WEBHOOK_SECRET=your-webhook-secret
